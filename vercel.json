{
  "version": 2,
  "buildCommand": "bash scripts/vercel-build.sh",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "ScramJet/{assets/**,static/**,packages/core/dist/**,packages/controller/dist/**,node_modules/.pnpm/node_modules/@mercuryworkshop/libcurl-transport/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
